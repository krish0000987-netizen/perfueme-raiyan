# RAIYAAN LUXURY — Environment Configuration Example

# 1. Brand & Contact Configuration
# Note: The supplied number (+91 911100822) has 9 digits after +91.
# Provide the full 10-digit Indian WhatsApp mobile number here:
NEXT_PUBLIC_WHATSAPP_NUMBER=919111008220
NEXT_PUBLIC_SITE_URL=https://raiyaanluxury.com

# 2. Payment Gateway Configuration (Razorpay - India)
# Register at https://razorpay.com to obtain test and live API keys:
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# 3. Database & Storage Configuration (Supabase PostgreSQL)
# Register at https://supabase.com:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret

# 4. Transactional Concierge Email Service (Optional: Resend / SendGrid)
RESEND_API_KEY=re_your_resend_api_key
